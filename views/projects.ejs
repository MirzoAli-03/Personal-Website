<!DOCTYPE html>
<html lang="en">
<head><%- include("partials/head", { description: "Selected projects and work by " + settings.full_name }) %></head>
<body>
<%- include("partials/header") %>

<main>
  <section class="hero" style="padding-bottom:24px">
    <div class="container">
      <div class="hero-eyebrow">Portfolio</div>
      <h1>Projects</h1>
      <p class="lead">A selection of things I've built.</p>
    </div>
  </section>

  <section style="padding-top:16px">
    <div class="container">
      <% if (projects.length) { %>
        <div class="grid">
          <% projects.forEach(function (p) { %>
            <%- include("partials/project-card", { p: p }) %>
          <% }); %>
        </div>
      <% } else { %>
        <p class="section-intro">No projects yet. Add your first one from the admin panel.</p>
      <% } %>
    </div>
  </section>
</main>

<%- include("partials/footer") %>
</body>
</html>
