<!DOCTYPE html>
<html lang="en">
<head><%- include("partials/head", { description: post.excerpt }) %></head>
<body>
<%- include("partials/header") %>

<main>
  <article>
    <div class="post-header">
      <div class="container">
        <a href="/blog" class="back-link">← Back to blog</a>
        <div class="post-meta">
          <%= formatDate(post.published_at) %> · <%= readingTime(post.body) %> min read<% if (post.tag) { %> · <%= post.tag %><% } %>
        </div>
        <h1><%= post.title %></h1>
      </div>
    </div>

    <div class="container">
      <% if (post.cover_image_id) { %>
        <img class="post-cover" src="/images/<%= post.cover_image_id %>" alt="<%= post.title %>">
      <% } %>
      <div class="post-body">
        <%- post.body %>
        <p><a href="/blog" class="back-link">← Back to all posts</a></p>
      </div>
    </div>
  </article>
</main>

<%- include("partials/footer") %>
</body>
</html>
