<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title ? title + " — " + settings.full_name : settings.full_name %></title>
<meta name="description" content="<%= typeof description !== 'undefined' && description ? description : (settings.tagline || '') %>">
<link rel="stylesheet" href="/assets/css/style.css">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>✦</text></svg>">
<script>
  // Applied before paint so the correct theme renders on first frame.
  (function () {
    try {
      var t = localStorage.getItem("theme");
      if (t) document.documentElement.setAttribute("data-theme", t);
    } catch (e) {}
  })();
</script>
