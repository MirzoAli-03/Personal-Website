<a class="card" href="/blog/<%= post.slug %>">
  <% if (post.cover_image_id) { %>
    <img class="project-thumb" src="/images/<%= post.cover_image_id %>" alt="<%= post.title %>" loading="lazy">
  <% } %>
  <% if (post.tag) { %><div class="tag-row"><span class="tag"><%= post.tag %></span></div><% } %>
  <h3><%= post.title %></h3>
  <% if (post.excerpt) { %><p><%= post.excerpt %></p><% } %>
  <div class="card-meta">
    <span><%= formatDate(post.published_at) %></span>
    <span class="card-link">Read →</span>
  </div>
</a>
