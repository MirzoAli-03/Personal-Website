<!DOCTYPE html>
<html lang="en">
<head><%- include("partials/head", { description: "Get in touch with " + settings.full_name }) %></head>
<body>
<%- include("partials/header") %>

<main>
  <section class="hero" style="padding-bottom:24px">
    <div class="container">
      <div class="hero-eyebrow">Contact</div>
      <h1>Get in touch</h1>
      <p class="lead">The fastest way to reach me is email. I read everything and usually reply within a couple of days.</p>
      <div class="hero-actions">
        <% if (settings.email) { %>
          <a href="mailto:<%= settings.email %>" class="btn btn-primary"><%= settings.email %></a>
        <% } %>
        <% if (settings.linkedin_url) { %>
          <a href="<%= settings.linkedin_url %>" target="_blank" rel="noopener" class="btn btn-secondary">LinkedIn</a>
        <% } %>
      </div>
    </div>
  </section>
</main>

<%- include("partials/footer") %>
</body>
</html>
