<!DOCTYPE html>
<html lang="en">
<head><%- include("layout-head") %></head>
<body class="admin-body">
<%- include("nav") %>

<main class="admin-main">
  <div class="admin-container">
    <h1 class="admin-title">Welcome back, <%= admin.username %></h1>

    <div class="stat-grid">
      <a class="stat-card" href="/admin/posts">
        <span class="stat-num"><%= posts.filter(p => p.published).length %></span>
        <span class="stat-label">Published posts</span>
        <span class="stat-sub"><%= posts.filter(p => !p.published).length %> draft(s)</span>
      </a>
      <a class="stat-card" href="/admin/projects">
        <span class="stat-num"><%= projects.length %></span>
        <span class="stat-label">Projects</span>
        <span class="stat-sub"><%= projects.filter(p => p.featured).length %> featured</span>
      </a>
      <a class="stat-card" href="/admin/images">
        <span class="stat-num"><%= images.length %></span>
        <span class="stat-label">Images</span>
        <span class="stat-sub"><%= (images.reduce((s, i) => s + i.byte_size, 0) / 1048576).toFixed(1) %> MB stored</span>
      </a>
      <a class="stat-card" href="/admin/settings">
        <span class="stat-num">⚙</span>
        <span class="stat-label">Site settings</span>
        <span class="stat-sub"><%= settings.full_name %></span>
      </a>
    </div>

    <div class="admin-actions-row">
      <a href="/admin/posts/new" class="btn btn-primary">Write a post</a>
      <a href="/admin/projects/new" class="btn btn-secondary">Add a project</a>
      <a href="/admin/images" class="btn btn-secondary">Upload images</a>
    </div>

    <section class="panel">
      <div class="panel-head">
        <h2>Recent posts</h2>
        <a href="/admin/posts" class="see-all">All posts →</a>
      </div>
      <% if (posts.length) { %>
        <table class="admin-table">
          <thead><tr><th>Title</th><th>Status</th><th>Date</th><th></th></tr></thead>
          <tbody>
            <% posts.slice(0, 5).forEach(function (p) { %>
              <tr>
                <td><a href="/admin/posts/<%= p.id %>/edit"><%= p.title %></a></td>
                <td>
                  <span class="pill <%= p.published ? 'pill-live' : 'pill-draft' %>">
                    <%= p.published ? "Published" : "Draft" %>
                  </span>
                </td>
                <td class="muted"><%= formatDate(p.published_at || p.updated_at) %></td>
                <td class="right"><a href="/admin/posts/<%= p.id %>/edit" class="link">Edit</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } else { %>
        <p class="empty">No posts yet. <a href="/admin/posts/new">Write your first one →</a></p>
      <% } %>
    </section>
  </div>
</main>

<script src="/assets/js/main.js"></script>
</body>
</html>
