<!DOCTYPE html>
<html lang="en">
<head><%- include("layout-head") %></head>
<body class="admin-body">
<%- include("nav") %>

<main class="admin-main">
  <div class="admin-container narrow">
    <div class="admin-title-row">
      <h1 class="admin-title"><%= project ? "Edit project" : "New project" %></h1>
      <a href="/admin/projects" class="link">← All projects</a>
    </div>

    <form method="post" action="<%= project ? '/admin/projects/' + project.id : '/admin/projects' %>">
      <section class="panel">
        <div class="field">
          <label for="title">Title</label>
          <input type="text" id="title" name="title" required value="<%= project ? project.title : '' %>">
        </div>

        <div class="field">
          <label for="description">Description</label>
          <textarea id="description" name="description" rows="3"
                    placeholder="What it is and the problem it solves"><%= project ? project.description : '' %></textarea>
        </div>

        <div class="field-row">
          <div class="field">
            <label for="tags">Tags</label>
            <input type="text" id="tags" name="tags" placeholder="React, Node.js"
                   value="<%= project ? (project.tags || []).join(', ') : '' %>">
            <p class="muted small">Comma separated.</p>
          </div>
          <div class="field">
            <label for="year">Year</label>
            <input type="text" id="year" name="year" value="<%= project ? project.year : '' %>" placeholder="2026">
          </div>
        </div>

        <div class="field-row">
          <div class="field">
            <label for="url">Link URL</label>
            <input type="url" id="url" name="url" placeholder="https://…"
                   value="<%= project ? project.url : '' %>">
          </div>
          <div class="field">
            <label for="link_label">Link label</label>
            <input type="text" id="link_label" name="link_label"
                   value="<%= project ? project.link_label : 'View' %>">
          </div>
        </div>

        <div class="field-row">
          <div class="field">
            <label for="sort_order">Sort order</label>
            <input type="number" id="sort_order" name="sort_order"
                   value="<%= project ? project.sort_order : 0 %>">
            <p class="muted small">Lower numbers appear first.</p>
          </div>
          <div class="field">
            <label for="cover_image_id">Cover image</label>
            <select name="cover_image_id" id="cover-select">
              <option value="">None</option>
              <% images.forEach(function (img) { %>
                <option value="<%= img.id %>" <%= project && project.cover_image_id === img.id ? "selected" : "" %>>
                  <%= img.filename %>
                </option>
              <% }); %>
            </select>
            <div id="cover-preview" class="cover-preview">
              <% if (project && project.cover_image_id) { %>
                <img src="/images/<%= project.cover_image_id %>" alt="">
              <% } %>
            </div>
          </div>
        </div>

        <label class="check">
          <input type="checkbox" name="featured" value="true" <%= project && project.featured ? "checked" : "" %>>
          <span>Show on the home page</span>
        </label>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Save project</button>
          <a href="/admin/projects" class="btn btn-secondary">Cancel</a>
        </div>
      </section>
    </form>

    <% if (project) { %>
      <form method="post" action="/admin/projects/<%= project.id %>/delete" class="danger-zone"
            data-confirm="Delete this project permanently?">
        <button type="submit" class="btn btn-danger">Delete this project</button>
      </form>
    <% } %>
  </div>
</main>

<script src="/assets/js/main.js"></script>
<script src="/assets/js/editor.js"></script>
</body>
</html>
