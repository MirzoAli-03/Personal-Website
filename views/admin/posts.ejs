<!DOCTYPE html>
<html lang="en">
<head><%- include("layout-head") %></head>
<body class="admin-body">
<%- include("nav") %>

<main class="admin-main">
  <div class="admin-container">
    <div class="admin-title-row">
      <h1 class="admin-title">Posts</h1>
      <a href="/admin/posts/new" class="btn btn-primary">Write a post</a>
    </div>

    <section class="panel">
      <% if (posts.length) { %>
        <table class="admin-table">
          <thead><tr><th>Title</th><th>Tag</th><th>Status</th><th>Date</th><th></th></tr></thead>
          <tbody>
            <% posts.forEach(function (p) { %>
              <tr>
                <td>
                  <a href="/admin/posts/<%= p.id %>/edit"><%= p.title %></a>
                  <div class="muted small">/blog/<%= p.slug %></div>
                </td>
                <td class="muted"><%= p.tag %></td>
                <td>
                  <span class="pill <%= p.published ? 'pill-live' : 'pill-draft' %>">
                    <%= p.published ? "Published" : "Draft" %>
                  </span>
                </td>
                <td class="muted"><%= formatDate(p.published_at || p.updated_at) %></td>
                <td class="right nowrap">
                  <% if (p.published) { %>
                    <a href="/blog/<%= p.slug %>" target="_blank" rel="noopener" class="link">View</a>
                  <% } %>
                  <a href="/admin/posts/<%= p.id %>/edit" class="link">Edit</a>
                  <form method="post" action="/admin/posts/<%= p.id %>/delete" class="inline"
                        data-confirm="Delete this post? This cannot be undone.">
                    <button type="submit" class="link link-danger">Delete</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } else { %>
        <p class="empty">No posts yet. <a href="/admin/posts/new">Write your first one →</a></p>
      <% } %>
    </section>
  </div>
</main>

<script src="/assets/js/main.js"></script>
</body>
</html>
