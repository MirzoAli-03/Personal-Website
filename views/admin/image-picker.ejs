<div class="modal" id="image-picker" hidden>
  <div class="modal-backdrop" data-close-picker></div>
  <div class="modal-card">
    <div class="modal-head">
      <h3>Choose an image</h3>
      <button type="button" class="modal-close" data-close-picker aria-label="Close">×</button>
    </div>

    <div class="modal-upload">
      <label class="btn btn-secondary btn-sm">
        Upload new
        <input type="file" accept="image/*" id="picker-upload" hidden>
      </label>
      <span class="muted small" id="picker-status">Images are resized in your browser before upload.</span>
    </div>

    <div class="modal-body">
      <div class="image-grid" id="picker-grid">
        <% images.forEach(function (img) { %>
          <button type="button" class="image-tile" data-image-id="<%= img.id %>" data-alt="<%= img.alt_text %>">
            <img src="/images/<%= img.id %>" alt="<%= img.alt_text %>" loading="lazy">
            <span class="image-tile-name"><%= img.filename %></span>
          </button>
        <% }); %>
      </div>
      <% if (!images.length) { %>
        <p class="empty" id="picker-empty">No images yet — upload one above.</p>
      <% } %>
    </div>
  </div>
</div>
