<!DOCTYPE html>
<html lang="en">
<head><%- include("layout-head") %></head>
<body class="admin-body">
<%- include("nav") %>

<main class="admin-main">
  <div class="admin-container">
    <div class="admin-title-row">
      <h1 class="admin-title"><%= post ? "Edit post" : "New post" %></h1>
      <a href="/admin/posts" class="link">← All posts</a>
    </div>

    <% if (typeof saved !== "undefined" && saved) { %>
      <div class="alert alert-ok">Saved.</div>
    <% } %>

    <form method="post" action="<%= post ? '/admin/posts/' + post.id : '/admin/posts' %>" class="editor-form">
      <div class="editor-grid">
        <div class="editor-main">
          <div class="field">
            <label for="title">Title</label>
            <input type="text" id="title" name="title" required
                   value="<%= post ? post.title : '' %>" placeholder="Post title">
          </div>

          <div class="field">
            <label for="excerpt">Excerpt</label>
            <textarea id="excerpt" name="excerpt" rows="2"
                      placeholder="One or two lines shown on the blog index"><%= post ? post.excerpt : '' %></textarea>
          </div>

          <div class="field">
            <label>Body</label>
            <div class="toolbar" role="toolbar">
              <button type="button" data-cmd="bold" title="Bold"><b>B</b></button>
              <button type="button" data-cmd="italic" title="Italic"><i>I</i></button>
              <button type="button" data-block="h2" title="Heading">H2</button>
              <button type="button" data-block="h3" title="Subheading">H3</button>
              <button type="button" data-block="p" title="Paragraph">¶</button>
              <span class="toolbar-sep"></span>
              <button type="button" data-cmd="insertUnorderedList" title="Bullet list">• List</button>
              <button type="button" data-cmd="insertOrderedList" title="Numbered list">1. List</button>
              <button type="button" data-block="blockquote" title="Quote">❝</button>
              <button type="button" data-block="pre" title="Code block">&lt;/&gt;</button>
              <span class="toolbar-sep"></span>
              <button type="button" data-link title="Insert link">🔗 Link</button>
              <button type="button" data-insert-image title="Insert image">🖼 Image</button>
              <span class="toolbar-sep"></span>
              <button type="button" data-toggle-html title="Edit raw HTML">HTML</button>
            </div>
            <div id="editor" class="editor" contenteditable="true"><%- post ? post.body : '' %></div>
            <textarea id="html-source" class="editor html-source" hidden></textarea>
            <input type="hidden" name="body" id="body-input">
          </div>
        </div>

        <aside class="editor-side">
          <div class="side-panel">
            <h3>Publish</h3>
            <label class="check">
              <input type="checkbox" name="published" value="true" <%= post && post.published ? "checked" : "" %>>
              <span>Published</span>
            </label>
            <p class="muted small">
              <% if (post && post.published_at) { %>
                Live since <%= formatDate(post.published_at) %>.
              <% } else { %>
                Unchecked keeps this as a private draft.
              <% } %>
            </p>
            <button type="submit" class="btn btn-primary btn-block">Save post</button>
            <% if (post && post.published) { %>
              <a href="/blog/<%= post.slug %>" target="_blank" rel="noopener" class="btn btn-secondary btn-block">View live ↗</a>
            <% } %>
          </div>

          <div class="side-panel">
            <h3>Details</h3>
            <div class="field">
              <label for="tag">Tag</label>
              <input type="text" id="tag" name="tag" value="<%= post ? post.tag : 'Notes' %>">
            </div>
            <div class="field">
              <label for="slug">URL slug</label>
              <input type="text" id="slug" name="slug" value="<%= post ? post.slug : '' %>"
                     placeholder="auto-generated from title">
              <p class="muted small">/blog/<span id="slug-preview"><%= post ? post.slug : '…' %></span></p>
            </div>
          </div>

          <div class="side-panel">
            <h3>Cover image</h3>
            <select name="cover_image_id" id="cover-select">
              <option value="">None</option>
              <% images.forEach(function (img) { %>
                <option value="<%= img.id %>" <%= post && post.cover_image_id === img.id ? "selected" : "" %>>
                  <%= img.filename %>
                </option>
              <% }); %>
            </select>
            <div id="cover-preview" class="cover-preview">
              <% if (post && post.cover_image_id) { %>
                <img src="/images/<%= post.cover_image_id %>" alt="">
              <% } %>
            </div>
            <a href="/admin/images" class="link small">Manage images →</a>
          </div>
        </aside>
      </div>
    </form>

    <% if (post) { %>
      <form method="post" action="/admin/posts/<%= post.id %>/delete" class="danger-zone"
            data-confirm="Delete this post permanently? This cannot be undone.">
        <button type="submit" class="btn btn-danger">Delete this post</button>
      </form>
    <% } %>
  </div>
</main>

<%- include("image-picker", { images: images }) %>

<script src="/assets/js/main.js"></script>
<script src="/assets/js/editor.js"></script>
</body>
</html>
